      "caption": "NOTFALL-STOPP 🚨",
      "onClick": "SGT_EmergencyStop($id);"
    },
    {
      "type": "Button",
      "caption": "Kalibrierung Wasserpumpe (10 Sek)",
      "onClick": "SGT_CalibratePump($id, 'water', 10);"
    },
    {
      "type": "Button",
      "caption": "Kalibrierung Düngerpumpe (10 Sek)",
      "onClick": "SGT_CalibratePump($id, 'nutrient', 10);"
